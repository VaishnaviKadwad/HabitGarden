<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="controller.HabitGardenController" styleClass="root-pane">

    <top>
        <VBox alignment="CENTER" spacing="2" styleClass="header">
            <Label text="HabitGarden" styleClass="title"/>
            <Label text="Grow your routine, one day at a time" styleClass="subtitle"/>
        </VBox>
    </top>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">

            <!-- ============ TAB 1: ADD HABIT + HABIT LIST ============ -->
            <Tab text="My Habits">
                <VBox spacing="12" styleClass="tab-content">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="form-box">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <TextField fx:id="nameField" promptText="New habit (e.g. Drink Water)"
                                   HBox.hgrow="ALWAYS"/>
                        <ComboBox fx:id="frequencyBox" prefWidth="120"/>
                        <ComboBox fx:id="plantBox" prefWidth="120"/>
                        <Button text="Add Habit" onAction="#handleAddHabit" styleClass="primary-button"/>
                    </HBox>

                    <HBox spacing="16" alignment="CENTER_LEFT">
                        <Label fx:id="summaryLabel" styleClass="summary-label"/>
                        <Label fx:id="messageLabel" styleClass="message-label"/>
                    </HBox>

                    <TableView fx:id="habitTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="nameCol" text="Habit" prefWidth="200"/>
                            <TableColumn fx:id="frequencyCol" text="Frequency" prefWidth="90"/>
                            <TableColumn fx:id="plantCol" text="Plant" prefWidth="90"/>
                            <TableColumn fx:id="stageCol" text="Stage" prefWidth="80"/>
                            <TableColumn fx:id="streakCol" text="Streak" prefWidth="90"/>
                            <TableColumn fx:id="statusCol" text="Status" prefWidth="150"/>
                            <TableColumn fx:id="actionCol" text="Actions" prefWidth="170" sortable="false"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- ============ TAB 2: GARDEN DASHBOARD ============ -->
            <Tab text="Garden">
                <ScrollPane fitToWidth="true" styleClass="garden-scroll">
                    <FlowPane fx:id="gardenPane" hgap="16" vgap="16" styleClass="garden-pane">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                    </FlowPane>
                </ScrollPane>
            </Tab>

        </TabPane>
    </center>
</BorderPane>
